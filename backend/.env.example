# ShieldAgent Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# PayPal Developer Sandbox Credentials
# Obtain these from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# AI / LLM Integration (OpenAI, Gemini, Anthropic, or Local)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL_NAME=gemini-1.5-pro

# Triage & Automation Thresholds
MIN_WIN_PROBABILITY_TO_DEFEND=60.0
MAX_DISPUTE_AMOUNT_FOR_AUTO_CONCEDE=25.0
ENABLE_AUTONOMOUS_SUBMISSION=False
